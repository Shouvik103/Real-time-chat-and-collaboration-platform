{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "Unified backend for the Chat Platform — Auth, Messaging & Socket.IO",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "build": "npx prisma generate --schema=src/prisma/schema.prisma",
    "start": "node index.js",
    "test": "jest",
    "test:cov": "jest --coverage",
    "prisma:generate": "npx prisma generate --schema=src/prisma/schema.prisma",
    "prisma:migrate:dev": "npx prisma migrate dev --schema=src/prisma/schema.prisma",
    "prisma:migrate:deploy": "npx prisma migrate deploy --schema=src/prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=src/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.12",
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.1",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
    "supertest": "^6.3.4"
  }
}
